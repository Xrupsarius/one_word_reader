{
  "name": "viewreader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-pdf-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-pdf-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests scripts vite.config.ts tsconfig.json package.json index.html",
    "format:check": "prettier --check src tests scripts vite.config.ts tsconfig.json package.json index.html"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
